func bigfunc(p0 p1 p2 p3 p4 p5 p6 p7 p8 p9 p10 p11 p12 p13 p14 p15 p16 p17)
  r0 = call :sub(p0 p1)
  r1 = p2 + p3
  r2 = p4 + p5
  r3 = p6 + p7
  r4 = p8 + p9
  r5 = p10 + p11
  r6 = p12 + p13
  r7 = p14 + p15
  r8 = p16 + p17
  r9 = r0 + r1
  r10 = r2 + r3
  r11 = r4 + r5
  r12 = r6 + r7
  r13 = r8 + r9
  r14 = r10 + r11
  r15 = r12 + r13
  r16 = r14 + r15
  return r16

func sub(a b)
  c = a + b
  return c
