func Main()
    fptr = @ManyLive_test
    v0 = call fptr()
    print(v0)
    v1 = 0
    return v1

func ManyLive_test()
    a0 = 1
    a1 = 2
    a2 = 3
    a3 = 4
    a4 = 5
    a5 = 6
    a6 = 7
    a7 = 8
    a8 = 9
    a9 = 10
    a10 = 11
    a11 = 12
    a12 = 13
    a13 = 14
    a14 = 15
    a15 = 16
    fptr2 = @helper
    r0 = call fptr2(a0 a1)
    b1 = a2 + a3
    b2 = a4 + a5
    b3 = a6 + a7
    b4 = a8 + a9
    b5 = a10 + a11
    b6 = a12 + a13
    b7 = a14 + a15
    b8 = r0 + b1
    b9 = b2 + b3
    b10 = b4 + b5
    b11 = b6 + b7
    b12 = b8 + b9
    b13 = b10 + b11
    b14 = b12 + b13
    return b14

func helper(x y)
    z = x + y
    return z
