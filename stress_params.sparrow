func Main()
    v0 = 1
    v1 = 2
    v2 = 3
    v3 = 4
    v4 = 5
    v5 = 6
    v6 = 7
    v7 = 8
    v8 = 9
    v9 = 10
    v10 = 11
    v11 = 12
    v12 = 13
    v13 = 14
    v14 = 15
    v15 = 16
    fptr = @bigparams
    result = call fptr(v0 v1 v2 v3 v4 v5 v6 v7 v8 v9 v10 v11 v12 v13 v14 v15)
    print(result)
    v16 = 0
    return v16

func bigparams(p0 p1 p2 p3 p4 p5 p6 p7 p8 p9 p10 p11 p12 p13 p14 p15)
    fptr = @helper
    r0 = call fptr(p0 p1)
    b1 = p2 + p3
    b2 = p4 + p5
    b3 = p6 + p7
    b4 = p8 + p9
    b5 = p10 + p11
    b6 = p12 + p13
    b7 = p14 + p15
    b8 = r0 + b1
    b9 = b2 + b3
    b10 = b4 + b5
    b11 = b6 + b7
    b12 = b8 + b9
    b13 = b10 + b11
    b14 = b12 + b13
    return b14

func helper(x y)
    z = x + y
    return z
