func compute(a0 a1 a2 a3 a4 a5 a6 a7 a8 a9 a10 a11 a12 a13 a14 a15)
  b0 = call :helper(a0 a1)
  b1 = a2 + a3
  b2 = a4 + a5
  b3 = a6 + a7
  b4 = a8 + a9
  b5 = a10 + a11
  b6 = a12 + a13
  b7 = a14 + a15
  b8 = b0 + b1
  b9 = b2 + b3
  b10 = b4 + b5
  b11 = b6 + b7
  b12 = b8 + b9
  b13 = b10 + b11
  b14 = b12 + b13
  return b14

func helper(x y)
  z = x + y
  return z
