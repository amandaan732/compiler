.equiv @sbrk, 9
.equiv @print_string, 4
.equiv @print_char, 11
.equiv @print_int, 1
.equiv @exit, 10
.equiv @exit2, 17
.text
.globl main
main:
  jal Main
  li a0, @exit
  ecall
.globl print
print:
  mv a1, a0
  li a0, @print_int
  ecall
  li a1, 10
  li a0, @print_char
  ecall
  jr ra
.globl error
error:
  mv a1, a0
  li a0, @print_string
  ecall
  li a1, 10
  li a0, @print_char
  ecall
  li a0, @exit
  ecall
abort_17:
  j abort_17
.globl alloc
alloc:
  mv a1, a0
  li a0, @sbrk
  ecall
  jr ra
.data
.globl msg_nullptr
msg_nullptr:
  .asciiz "null pointer"
  .align 2
.globl msg_array_oob
msg_array_oob:
  .asciiz "array index out of bounds"
  .align 2
.text
.globl Main
Main:
  sw fp, -8(sp)
  mv fp, sp
  li t0, 32
  sub sp, sp, t0
  sw ra, -4(fp)
  li t0, 4
  sw t0, -12(fp)
  lw t1, -12(fp)
  mv a0, t1
  jal alloc
  mv t0, a0
  sw t0, -16(fp)
  lw t1, -12(fp)
  mv a0, t1
  jal alloc
  mv t0, a0
  sw t0, -20(fp)
  la t0, FacComputeFac
  sw t0, -12(fp)
  lw t0, -20(fp)
  lw t1, -12(fp)
  sw t1, 0(t0)
  lw t0, -20(fp)
  sw t0, -12(fp)
  lw t0, -16(fp)
  lw t1, -12(fp)
  sw t1, 0(t0)
  lw t0, -16(fp)
  bnez t0, Main_br0
  j Main_null1
Main_br0:
  lw t1, -16(fp)
  lw t0, 0(t1)
  sw t0, -24(fp)
  lw t1, -24(fp)
  lw t0, 0(t1)
  sw t0, -24(fp)
  li t0, 6
  sw t0, -12(fp)
  lw t1, -24(fp)
  lw a0, -16(fp)
  lw a1, -12(fp)
  jalr t1
  mv t0, a0
  sw a0, -28(fp)
  sw t0, -32(fp)
  lw t0, -32(fp)
  mv a0, t0
  jal print
  j Main_main_end
Main_null1:
  la a0, msg_nullptr
  jal error
Main_main_end:
  lw a0, -12(fp)
  lw ra, -4(fp)
  lw fp, -8(fp)
  li t0, 32
  add sp, sp, t0
  jr ra

.globl FacComputeFac
FacComputeFac:
  sw fp, -8(sp)
  mv fp, sp
  li t0, 48
  sub sp, sp, t0
  sw ra, -4(fp)
  sw a0, -12(fp)
  sw a1, -16(fp)
  li t0, 1
  sw t0, -20(fp)
  lw t1, -16(fp)
  lw t2, -20(fp)
  slt t0, t1, t2
  sw t0, -24(fp)
  lw t0, -24(fp)
  bnez t0, FacComputeFac_br1
  j FacComputeFac_if1_else
FacComputeFac_br1:
  li t0, 1
  sw t0, -28(fp)
  j FacComputeFac_if1_end
FacComputeFac_if1_else:
  lw t1, -12(fp)
  lw t0, 0(t1)
  sw t0, -32(fp)
  lw t1, -32(fp)
  lw t0, 0(t1)
  sw t0, -32(fp)
  li t0, 1
  sw t0, -20(fp)
  lw t1, -16(fp)
  lw t2, -20(fp)
  sub t0, t1, t2
  sw t0, -36(fp)
  lw t1, -32(fp)
  lw a0, -12(fp)
  lw a1, -36(fp)
  jalr t1
  mv t0, a0
  sw a0, -40(fp)
  sw t0, -44(fp)
  lw t1, -16(fp)
  lw t2, -44(fp)
  mul t0, t1, t2
  sw t0, -28(fp)
FacComputeFac_if1_end:
  lw a0, -28(fp)
  lw ra, -4(fp)
  lw fp, -8(fp)
  li t0, 48
  add sp, sp, t0
  jr ra

