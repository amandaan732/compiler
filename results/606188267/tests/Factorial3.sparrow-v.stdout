  .equiv @print_int, 1
  .equiv @print_char, 11
  .equiv @exit, 10
  .equiv @sbrk, 9

.data
_nl: .asciiz "\n"

.text
  jal Main
  li a0, @exit
  ecall

alloc:
  mv a1, a0
  li a0, @sbrk
  ecall
  jr ra

Main:
  addi sp, sp, -64
  sw ra, 60(sp)
  sw s0, 56(sp)
  addi s0, sp, 64
  li t0, 4
  sw t0, -12(s0)
  sw v0, -16(s0)
  mv a0, t1
  jal alloc
  mv t0, a0
  sw t0, -20(s0)
  sw v0, -16(s0)
  mv a0, t1
  jal alloc
  mv t3, a0
  la t0, FacComputeFac
  sw t0, -12(s0)
  sw v0, -16(s0)
  sw t1, 0(t3)
  sw t3, -12(s0)
  sw w0, -24(s0)
  sw v0, -16(s0)
  sw t1, 0(t0)
  sw w0, -16(s0)
  beqz t1, null1
  sw w0, -16(s0)
  lw t4, 0(t1)
  lw t4, 0(t4)
  li t0, 6
  sw t0, -12(s0)
  sw t3, -28(s0)
  sw t4, -32(s0)
  sw t5, -36(s0)
  sw w0, -24(s0)
  sw t0, -40(s0)
  sw v0, -24(s0)
  sw t0, -44(s0)
  jalr t4
  sw a0, -24(s0)
  sw stack_save_t4, -48(s0)
  sw stack_save_t5, -52(s0)
  sw stack_save_t3, -56(s0)
  sw t0, -52(s0)
  mv a1, t5
  li a0, @print_int
  ecall
  li a1, 10
  li a0, @print_char
  ecall
  j main_end
null1:
  li a0, @exit
  ecall
main_end:
  lw a0, -12(s0)
  lw ra, 60(sp)
  lw s0, 56(sp)
  addi sp, sp, 64
  jr ra

FacComputeFac:
  addi sp, sp, -80
  sw ra, 76(sp)
  sw s0, 72(sp)
  addi s0, sp, 80
  sw s1, -12(s0)
  li t3, 1
  slt t4, a3, t3
  beqz t4, if1_else
  li t0, 1
  sw t0, -16(s0)
  j if1_end
if1_else:
  lw t5, 0(a2)
  lw t5, 0(t5)
  li t3, 1
  sub t0, a3, t3
  sw t0, -20(s0)
  sw t3, -24(s0)
  sw t4, -28(s0)
  sw t5, -32(s0)
  sw a2, -36(s0)
  sw a3, -40(s0)
  sw stack_save_a2, -44(s0)
  sw t0, -48(s0)
  sw w2, -44(s0)
  sw t0, -52(s0)
  jalr t5
  sw a0, -44(s0)
  sw stack_save_t4, -56(s0)
  sw stack_save_t5, -60(s0)
  sw stack_save_a2, -48(s0)
  sw stack_save_a3, -52(s0)
  sw stack_save_t3, -64(s0)
  sw t0, -68(s0)
  mul t0, a3, s1
  sw t0, -16(s0)
if1_end:
  sw stack_save_s1, -68(s0)
  lw a0, -16(s0)
  lw ra, 76(sp)
  lw s0, 72(sp)
  addi sp, sp, 80
  jr ra

